# Copy to .env locally, or paste as environment variables in the Koyeb service.
# Generate each key with:  openssl rand -hex 32
AC_SESSION_KEY=
AC_SERVER_KEY=
AC_ADMIN_KEY=

AC_META_APP_ID=1251153274754895
AC_META_APP_SECRET=
AC_META_PACKAGE_ID=com.LegendaryLLC.CrabTag

# Leave blank on the first run. Blank means "allow anything" - fill these in
# from the real values your App Lab build produces, then enforce.
AC_META_ALLOWED_APP_INTEGRITY=
AC_META_ALLOWED_DEVICE_INTEGRITY=
AC_META_ALLOWED_CERT_DIGESTS=

AC_PLAYFAB_TITLE_ID=FBFD4
AC_PLAYFAB_SECRET_KEY=

AC_DISCORD_SECURITY=
AC_DISCORD_MODERATION=

# Neon -> Connection Details -> connection string.
# On Vercel use the POOLED endpoint (host contains "-pooler"); serverless makes
# many short-lived connections. On a long-lived host like Render use the direct
# endpoint instead.
AC_DATABASE_URL=

# Set false after running migrate.py once, so cold starts skip the schema DDL.
AC_AUTO_MIGRATE=true

AC_ENFORCE=false
AC_DETECTION_RETENTION_DAYS=30
